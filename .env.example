# 环境变量示例

MORROW_APP_URL=http://localhost:3000

# SQLite 数据库路径；生产环境应指向持久化磁盘
MORROW_DB_PATH=./data/morrow.db

# 上传文件目录；生产环境应指向持久化磁盘
MORROW_UPLOAD_DIR=./data/uploads

# 首次运行 npm run db:setup 时使用的负责人信息
MORROW_OWNER_EMAIL=owner@morrow.local
MORROW_OWNER_NAME=Morrow 发起人
MORROW_OWNER_PASSWORD=

# 生产环境邮件发送（Resend）
RESEND_API_KEY=
MORROW_FROM_EMAIL=
